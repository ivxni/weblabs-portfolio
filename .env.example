# Kopie als .env anlegen (lokal) bzw. in Coolify unter Environment Variables
# eintragen. KEINE dieser Variablen ist zum Starten nötig — die Seite läuft
# vollständig ohne sie. Fehlt die SMTP-Konfiguration, meldet das
# Kontaktformular das offen und bietet den direkten E-Mail-Weg an.

# ---- Kontaktformular --------------------------------------------------------
# Nur wirksam, wenn ALLE fünf plus CONTACT_TO gesetzt sind.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@web-labs.io

# Postfach, an das Kontaktanfragen zugestellt werden.
CONTACT_TO=can.cadirci02@outlook.com
# Optional: Verifizierungstoken aus der Google Search Console.
# In Coolify als Build Variable setzen, anschließend neu deployen.
GOOGLE_SITE_VERIFICATION=
